# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.2.0"
synopsis: "Time-bounded computations and stream iteration"
description: """
This package exposes the `eventually` monad
   for computations run against a logical time budget,
   which may be infinite (risking that the computation diverges)
   or finite (resulting in a timeout instead).
   The package provides a reader/writer interface for stream processing,
   and implements time-bounded stream operations
   by way of the `eventually` monad."""
maintainer: ["William (Liam) Schilling"]
authors: ["William (Liam) Schilling"]
license: "MIT"
tags: ["divergence" "lazy evaluation" "streams" "monads"]
homepage: "https://github.com/LiamSchilling/eventually-ocaml"
doc: "https://liamschilling.github.io/eventually-ocaml/"
bug-reports: "https://github.com/LiamSchilling/eventually-ocaml/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.14" & >= "3.14"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/LiamSchilling/eventually-ocaml.git"
